{
  "name": "mi-primer-proyecto",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:dev": "ng build --configuration development --base-href /",
    "build:staging": "ng build --configuration staging --base-href / --optimization true --build-optimizer true",
    "build:prod": "ng build --configuration production --base-href / --optimization true --build-optimizer true --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --no-watch --code-coverage --browsers=ChromeHeadless",
    "e2e:ci": "ng e2e --protractor --watch=false",
    "lint": "ng lint || true",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\"",
    "analyze": "webpack-bundle-analyzer dist/mi-primer-proyecto/browser/stats.json",
    "firebase:deploy:dev": "firebase deploy --project your-project-dev --only hosting",
    "firebase:deploy:staging": "firebase deploy --project your-project-staging --only hosting",
    "firebase:deploy:prod": "firebase deploy --project your-project-prod --only hosting"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}